# Environnement logique : development | preview | production
# En production, le build/startup échoue si le token, l'URL ou les mentions
# légales obligatoires manquent. Sur Vercel, VERCEL_ENV est utilisé si APP_ENV
# n'est pas défini.
APP_ENV="development"

# Mode démo : autorisé en développement/préproduction, interdit en production.
# En preview Vercel sans token, la démo est active automatiquement.
ALLOW_DEMO="true"

# Secret de signature des cookies (obligatoire en production, >= 32 caractères)
# Génère-le avec : openssl rand -base64 48
COOKIE_SECRET=""

# Faire confiance à x-forwarded-for / x-real-ip derrière un proxy de confiance.
# Sur Vercel, VERCEL=1 active automatiquement ce comportement.
TRUST_PROXY="false"

# Token public Tebex (Creator Panel -> Developers -> API Keys)
# Laisse vide pour utiliser le mode démo en développement/préproduction.
# Le token public est conçu pour le storefront. Ne mets JAMAIS le private key ici.
TEBEX_PUBLIC_TOKEN=""

# URL publique du site (sans slash final)
# En local : http://localhost:3000
# En préproduction : https://<preview>.vercel.app
# En production : https://tbnk-smp.com (HTTPS obligatoire)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Identité légale et contacts obligatoires en production (Loi 25 / LPC Québec)
NEXT_PUBLIC_LEGAL_NAME=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
NEXT_PUBLIC_LEGAL_PHONE=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_PRIVACY_EMAIL=""
NEXT_PUBLIC_PRIVACY_OFFICER=""

# true si les prix Tebex affichés incluent déjà les taxes ; false sinon.
NEXT_PUBLIC_PRICES_INCLUDE_TAXES="false"

# Optionnel : surcharge de l'URL de l'API Headless Tebex (tests avancés uniquement)
# TEBEX_API_BASE=""
